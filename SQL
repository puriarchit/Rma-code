DECLARE @kill varchar(8000) = '';  
SELECT @kill = @kill + 'kill ' + CONVERT(varchar(5), session_id) + ';'  
FROM sys.dm_exec_sessions
WHERE database_id  = DB_ID('LexisNexis_Staging')
  AND session_id <> @@SPID;
EXEC(@kill);


SELECT 
    session_id,
    status,
    command,
    blocking_session_id,
    wait_type,
    wait_time / 1000 AS wait_seconds,
    DB_NAME(database_id) as database_name,
    (SELECT SUBSTRING(text, statement_start_offset/2 + 1,
        (CASE WHEN statement_end_offset = -1 
            THEN LEN(CONVERT(nvarchar(max), text)) * 2 
            ELSE statement_end_offset 
        END - statement_start_offset)/2)
     FROM sys.dm_exec_sql_text(sql_handle)) AS query_text
FROM sys.dm_exec_requests
WHERE session_id <> @@SPID;


SELECT 
    (SELECT COUNT(*) FROM NegativeList_New WITH (NOLOCK)) AS [Rows Loaded Into Target Table],
    req.status AS [Query Status],
    req.command AS [Command],
    req.wait_type AS [Wait Reason],
    req.wait_time / 1000 AS [Wait Time (Seconds)],
    req.granted_query_memory * 8 / 1024 AS [Memory Allocated (MB)]
FROM sys.dm_exec_requests req
WHERE req.session_id <> @@SPID 
  AND req.database_id = DB_ID('LexisNexis_Staging');


SELECT 
    session_id,
    status AS [Query Status],
    command AS [Command],
    wait_type AS [Wait Reason],
    wait_time / 1000 AS [Wait Time (Seconds)],
    granted_query_memory * 8 / 1024 AS [Memory Allocated (MB)]
FROM sys.dm_exec_requests
WHERE session_id <> @@SPID 
  AND database_id = DB_ID('LexisNexis_Staging');
