USE master;
GO

SELECT name, state_desc, recovery_model_desc 
FROM sys.databases 
WHERE name = 'LexisNexis_Staging';
GO




USE master;
GO

IF NOT EXISTS (SELECT name FROM sys.databases WHERE name = N'LexisNexis_Staging')
BEGIN
    CREATE DATABASE LexisNexis_Staging;
END
GO

ALTER DATABASE LexisNexis_Staging SET RECOVERY SIMPLE;
GO





USE LexisNexis_Staging;
GO

SELECT 
    t.name AS TableName,
    p.rows AS RowCounts
FROM sys.tables t
INNER JOIN sys.partitions p ON t.object_id = p.object_id
WHERE p.index_id IN (0, 1)
ORDER BY t.name;
GO




USE master;
GO

ALTER DATABASE LexisNexis_Staging SET MULTI_USER WITH ROLLBACK IMMEDIATE;
GO


USE master;
GO

-- Data file ko 20 GB aur Log file ko 2 GB ka bana dega
ALTER DATABASE LexisNexis_Staging MODIFY FILE (NAME = N'LexisNexis_Staging', SIZE = 20000MB);
ALTER DATABASE LexisNexis_Staging MODIFY FILE (NAME = N'LexisNexis_Staging_log', SIZE = 2000MB);
GO
