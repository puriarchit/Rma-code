USE master;
GO

SELECT name, state_desc, recovery_model_desc 
FROM sys.databases 
WHERE name = 'LexisNexis_Staging';
GO




USE master;
GO

IF NOT EXISTS (SELECT name FROM sys.databases WHERE name = N'LexisNexis_Staging')
BEGIN
    CREATE DATABASE LexisNexis_Staging;
END
GO

ALTER DATABASE LexisNexis_Staging SET RECOVERY SIMPLE;
GO





USE LexisNexis_Staging;
GO

SELECT 
    t.name AS TableName,
    p.rows AS RowCounts
FROM sys.tables t
INNER JOIN sys.partitions p ON t.object_id = p.object_id
WHERE p.index_id IN (0, 1)
ORDER BY t.name;
GO




USE master;
GO

ALTER DATABASE LexisNexis_Staging SET MULTI_USER WITH ROLLBACK IMMEDIATE;
GO


USE master;
GO

-- Data file ko 20 GB aur Log file ko 2 GB ka bana dega
ALTER DATABASE LexisNexis_Staging MODIFY FILE (NAME = N'LexisNexis_Staging', SIZE = 20000MB);
ALTER DATABASE LexisNexis_Staging MODIFY FILE (NAME = N'LexisNexis_Staging_log', SIZE = 2000MB);
GO





SELECT name, delayed_durability_desc 
FROM sys.databases 
WHERE name = 'LexisNexis_Staging';



SELECT session_id, wait_type, wait_duration_ms, resource_description
FROM sys.dm_os_waiting_tasks
WHERE session_id > 50 
  AND wait_type NOT IN ('WAITFOR', 'BROKER_RECEIVER_WAIT_TYPE', 'DIRTY_PAGE_TABLE_RELEASE');




SELECT SERVERPROPERTY('Collation') AS ServerCollation,
       DATABASEPROPERTYEX('LexisNexis_Staging', 'Collation') AS DbCollation;




SELECT OBJECT_NAME(object_id) AS TableName, name AS IndexName, type_desc
FROM sys.indexes
WHERE object_id IN (OBJECT_ID('Entity'), OBJECT_ID('EntityAlias'), OBJECT_ID('EntitySourceItem'))
  AND type > 0 AND is_primary_key = 0;


SELECT f.name, fs.num_of_writes, fs.io_stall_write_ms,
       (fs.io_stall_write_ms / NULLIF(fs.num_of_writes, 0)) AS AvgWriteStall_MS
FROM sys.dm_io_virtual_file_stats(DB_ID('LexisNexis_Staging'), NULL) fs
JOIN sys.master_files f ON fs.database_id = f.database_id AND fs.file_id = f.file_id;




USE master;
GO
ALTER DATABASE LexisNexis_Staging SET DELAYED_DURABILITY = FORCED;
GO
