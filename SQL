USE LexisNexis_Staging;
GO

SELECT 
    session_id, 
    command, 
    status, 
    row_count AS Live_Rows_Written_So_Far,
    total_elapsed_time / 1000 AS SecondsRunning
FROM sys.dm_exec_requests 
WHERE session_id > 50 AND command <> 'SELECT';


