SELECT 
    session_id,
    physical_operator_name,
    row_count,
    estimate_row_count,
    CAST((row_count * 100.0 / NULLIF(estimate_row_count, 0)) AS DECIMAL(5,2)) AS PercentComplete
FROM sys.dm_exec_query_profiles
WHERE session_id IN (
    SELECT session_id 
    FROM sys.dm_exec_requests 
    WHERE command = 'INSERT' OR command = 'SELECT'
);
