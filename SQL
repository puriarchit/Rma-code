USE master;
GO

SELECT 
    r.session_id AS [Session_ID],
    r.status AS [Status],
    r.command AS [Command],
    r.cpu_time AS [CPU_Time_ms],
    r.total_elapsed_time / 1000.0 AS [Elapsed_Sec],
    r.wait_type AS [Wait_Type],
    r.blocking_session_id AS [Blocked_By_Session],
    t.text AS [Executing_SQL_Text]
FROM sys.dm_exec_requests r
CROSS APPLY sys.dm_exec_sql_text(r.sql_handle) t
WHERE r.session_id <> @@SPID;
GO


USE LexisNexis_Staging_Run;
GO

SELECT 
    OBJECT_NAME(object_id) AS [Table_Name], 
    FORMAT(SUM(row_count), 'N0') AS [Total_Consolidated_Rows]
FROM sys.dm_db_partition_stats
WHERE object_id = OBJECT_ID('dbo.NegativeList_New1') AND index_id IN (0, 1)
GROUP BY object_id;
GO



USE LexisNexis_Staging_Run;
GO

SELECT 
    OBJECT_NAME(object_id) AS [Table_Name], 
    FORMAT(SUM(row_count), 'N0') AS [Live_Loaded_Rows]
FROM sys.dm_db_partition_stats
WHERE object_id = OBJECT_ID('dbo.NegativeList_Master') AND index_id IN (0, 1)
GROUP BY object_id;
GO



USE LexisNexis_Staging;
GO

SELECT 
    'NegativeList_Master' AS [Table_Name], 
    FORMAT(COUNT(*), 'N0') AS [Live_Uncommitted_Rows] 
FROM dbo.NegativeList_Master WITH (NOLOCK);
GO
