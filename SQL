SELECT 
    session_id,
    physical_operator_name,
    row_count,
    estimate_row_count,
    CAST((row_count * 100.0 / NULLIF(estimate_row_count, 0)) AS DECIMAL(5,2)) AS PercentComplete
FROM sys.dm_exec_query_profiles
WHERE session_id IN (
    SELECT session_id 
    FROM sys.dm_exec_requests 
    WHERE command = 'INSERT' OR command = 'SELECT'
);


SELECT 
    blocking_session_id AS BlockingSession,
    session_id AS BlockedSession,
    wait_type,
    wait_time / 1000 AS WaitSeconds,
    wait_resource
FROM sys.dm_exec_requests
WHERE blocking_session_id <> 0;



SELECT 
    session_id,
    status,
    command,
    blocking_session_id,
    wait_type,
    wait_time / 1000 AS wait_seconds,
    (SELECT SUBSTRING(text, statement_start_offset/2 + 1,
        (CASE WHEN statement_end_offset = -1 
            THEN LEN(CONVERT(nvarchar(max), text)) * 2 
            ELSE statement_end_offset 
        END - statement_start_offset)/2)
     FROM sys.dm_exec_sql_text(sql_handle)) AS query_text
FROM sys.dm_exec_requests
WHERE session_id = 54;


SELECT 
    session_id,
    status,
    command,
    blocking_session_id,
    wait_type,
    wait_time / 1000 AS wait_seconds,
    (SELECT SUBSTRING(text, statement_start_offset/2 + 1,
        (CASE WHEN statement_end_offset = -1 
            THEN LEN(CONVERT(nvarchar(max), text)) * 2 
            ELSE statement_end_offset 
        END - statement_start_offset)/2)
     FROM sys.dm_exec_sql_text(sql_handle)) AS query_text
FROM sys.dm_exec_requests
WHERE session_id <> @@SPID 
  AND database_id = DB_ID('LexisNexis_Staging');

