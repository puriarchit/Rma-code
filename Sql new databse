-- -------------------------------------------------------------------------------
-- 1. CHAPTER 13: SSIS VS PYTHON FINAL PRODUCTION PARITY MATCH (253,946 ROWS)
-- (Run this query to get a single grid comparing SSIS & Python row counts)
-- -------------------------------------------------------------------------------
SELECT 
    'SSIS Target Database (MoneyWaveRemit.dbo.NegativeList)' AS DatabaseEngine, 
    COUNT(*) AS TotalProductionRows 
FROM MoneyWaveRemit.dbo.NegativeList

UNION ALL

SELECT 
    'Python Target Database (LexisNexis_Staging_Run.dbo.NegativeList)' AS DatabaseEngine, 
    COUNT(*) AS TotalProductionRows 
FROM LexisNexis_Staging_Run.dbo.NegativeList

UNION ALL

SELECT 
    'Python Search Filter Table (LexisNexis_Staging_Run.dbo.NegativeListFilter)' AS DatabaseEngine, 
    COUNT(*) AS TotalProductionRows 
FROM LexisNexis_Staging_Run.dbo.NegativeListFilter;



-- -------------------------------------------------------------------------------
-- 2. CHAPTER 8: ID SLOT POSITION SORTING COMPARISON (SSIS VS PYTHON)
-- (Run this query to show side-by-side ID card slot sorting for ReferenceID 10003457)
-- -------------------------------------------------------------------------------
SELECT 
    'SSIS Output (Random Order)' AS Engine, 
    ReferenceID, 
    IdOtherInfo1, 
    IdNo1, 
    IdOtherInfo2, 
    IdNo2
FROM MoneyWaveRemit.dbo.NegativeList
WHERE ReferenceID = '10003457'

UNION ALL

SELECT 
    'Python Output (Alphabetical Order)' AS Engine, 
    ReferenceID, 
    IdOtherInfo1, 
    IdNo1, 
    IdOtherInfo2, 
    IdNo2
FROM LexisNexis_Staging_Run.dbo.NegativeList
WHERE ReferenceID = '10003457';



