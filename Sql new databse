USE master;
GO

-- 1. Database ko safely drop karke fresh create karein
IF EXISTS (SELECT name FROM sys.databases WHERE name = N'LexisNexis_Staging')
BEGIN
    ALTER DATABASE LexisNexis_Staging SET SINGLE_USER WITH ROLLBACK IMMEDIATE;
    DROP DATABASE LexisNexis_Staging;
END
GO

CREATE DATABASE LexisNexis_Staging;
GO

-- 2. Configuration settings (Instantly apply hongi)
ALTER DATABASE LexisNexis_Staging SET RECOVERY SIMPLE;
ALTER DATABASE LexisNexis_Staging SET DELAYED_DURABILITY = FORCED;
ALTER DATABASE LexisNexis_Staging SET COMPATIBILITY_LEVEL = 140;
GO

-- 3. Sirf filegrowth 1GB set karein (Ye bhi 1 second mein ho jayega)
ALTER DATABASE LexisNexis_Staging MODIFY FILE (NAME = LexisNexis_Staging, FILEGROWTH = 1024MB);
ALTER DATABASE LexisNexis_Staging MODIFY FILE (NAME = LexisNexis_Staging_log, FILEGROWTH = 1024MB);
GO
