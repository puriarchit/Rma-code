# -*- coding: utf-8 -*-
import os

def main():
    search_dir = r"D:\LexisNexis"
    target = "LexisNexis_Comparison_Report"
    
    if os.path.exists(search_dir):
        for root, dirs, files in os.walk(search_dir):
            for file in files:
                if file.endswith(".py"):
                    filepath = os.path.join(root, file)
                    try:
                        with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                            content = f.read()
                        if target in content:
                            print(f"Found in remote: {filepath}")
                    except Exception:
                        pass
    else:
        print("D:\\LexisNexis does not exist locally to check.")

if __name__ == "__main__":
    main()
