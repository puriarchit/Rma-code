# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    trusted = "yes" if db["trusted_connection"] else "no"
    conn_str = f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Data;Trusted_Connection={trusted};"
    
    conn = pyodbc.connect(conn_str, autocommit=True)
    cursor = conn.cursor()

    for ent_id in ['10006425', '10006431', '10007380']:
        cursor.execute("SELECT EntityGUID FROM Entity WHERE EntityID = ?", (ent_id,))
        row = cursor.fetchone()
        if not row:
            print(f"Entity {ent_id} not found.")
            continue
        guid = row[0]
        print(f"\n================ EntityID {ent_id} (GUID: {guid}) ================")
        
        # Query raw EntityDOB
        cursor.execute("""
            SELECT EntityDOBGUID, BirthYear, BirthMonth, BirthDay
            FROM EntityDOB
            WHERE EntityGUID = ?
        """, (guid,))
        print("--- Production Raw DOBs ---")
        for r in cursor.fetchall():
            print(f"GUID: {r[0]} | Year: {r[1]} | Month: {r[2]} | Day: {r[3]}")

    cursor.close()
    conn.close()

if __name__ == "__main__":
    main()

