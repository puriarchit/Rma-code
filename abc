# -*- coding: utf-8 -*-
import os

def main():
    search_dir = r"D:\LexisNexis"
    print(f"=== Searching for .dtsx files in {search_dir} ===")
    found = False
    if os.path.exists(search_dir):
        for root, dirs, files in os.walk(search_dir):
            for file in files:
                if file.endswith(".dtsx"):
                    print(f"Found: {os.path.join(root, file)}")
                    found = True
    else:
        print("Directory does not exist")
        
    if not found:
        print("No .dtsx files found in D:\\LexisNexis recursively.")

if __name__ == "__main__":
    main()
