# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    trusted = "yes" if db["trusted_connection"] else "no"
    
    conn_data = pyodbc.connect(f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Data;Trusted_Connection={trusted};")
    cursor_data = conn_data.cursor()
    
    conn_staging = pyodbc.connect(f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Staging;Trusted_Connection={trusted};")
    cursor_staging = conn_staging.cursor()

    ref_id = '1828440'
    
    cursor_data.execute("SELECT EntityGUID, Name FROM Entity WHERE EntityID = ?", (ref_id,))
    row_data = cursor_data.fetchone()
    print(f"Data DB: EntityGUID={row_data[0] if row_data else 'None'} | Name={row_data[1] if row_data else 'None'}")
    
    cursor_staging.execute("SELECT EntityGUID, Name FROM Entity WHERE EntityID = ?", (ref_id,))
    row_staging = cursor_staging.fetchone()
    print(f"Staging DB: EntityGUID={row_staging[0] if row_staging else 'None'} | Name={row_staging[1] if row_staging else 'None'}")

    if row_data and row_staging:
        guid_data = row_data[0]
        guid_staging = row_staging[0]
        
        print("\n--- LexisNexis_Data EntityIdentification ---")
        cursor_data.execute("SELECT EntityIdentificationGUID, IdentificationTypeDesc, IdentificationNumber FROM EntityIdentification WHERE EntityGUID = ?", (guid_data,))
        for r in cursor_data.fetchall():
            print(f"GUID: {r[0]} | Type: {r[1]} | Num: {r[2]}")
            
        print("\n--- LexisNexis_Staging EntityIdentification ---")
        cursor_staging.execute("SELECT EntityIdentificationGUID, IdentificationTypeDesc, IdentificationNumber FROM EntityIdentification WHERE EntityGUID = ?", (guid_staging,))
        for r in cursor_staging.fetchall():
            print(f"GUID: {r[0]} | Type: {r[1]} | Num: {r[2]}")

    cursor_data.close()
    conn_data.close()
    cursor_staging.close()
    conn_staging.close()

if __name__ == "__main__":
    main()

