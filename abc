# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    trusted = "yes" if db["trusted_connection"] else "no"
    conn_str = f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Data;Trusted_Connection={trusted};"
    
    conn = pyodbc.connect(conn_str, autocommit=True)
    cursor = conn.cursor()

    cursor.execute("SELECT Symbol, MapChar FROM dbo.WLCharMap")
    rows = cursor.fetchall()
    
    out_lines = []
    for sym, mc in rows:
        out_lines.append(f"Symbol: {repr(sym)} | MapChar: {repr(mc)}")
        
    with open("charmap.txt", "w", encoding="utf-8") as f:
        f.write("\n".join(out_lines))
        
    print(f"Success: Wrote {len(rows)} rows to D:\\LexisNexis\\charmap.txt")

    cursor.close()
    conn.close()

if __name__ == "__main__":
    main()
