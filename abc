-- 1. LexisNexis_Data (SSIS) ke raw PEP profiles count
SELECT COUNT(DISTINCT EntityGUID) 
FROM LexisNexis_Data.dbo.EntityCountryAssociation 
WHERE AssociationTypeDesc = 'PEP';

