# -*- coding: utf-8 -*-
import os
import re

def main():
    dtsx_dir = r"D:\LexisNexis"
    pattern = re.compile(r"EntityEnforcement", re.IGNORECASE)
    
    for filename in os.listdir(dtsx_dir):
        if filename.endswith(".dtsx"):
            filepath = os.path.join(dtsx_dir, filename)
            with open(filepath, "r", encoding="utf-8", errors="ignore") as f:
                content = f.read()
            if pattern.search(content):
                print(f"Found EntityEnforcement in {filename}")
                # Print lines containing EntityEnforcement
                lines = content.splitlines()
                for i, line in enumerate(lines):
                    if "EntityEnforcement" in line:
                        print(f"  Line {i+1}: {line.strip()[:150]}")

if __name__ == "__main__":
    main()


