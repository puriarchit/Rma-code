# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    trusted = "yes" if db["trusted_connection"] else "no"
    
    conn_data = pyodbc.connect(f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Data;Trusted_Connection={trusted};")
    cursor_data = conn_data.cursor()

    ref_id = '1828440'
    cursor_data.execute("SELECT EntityGUID FROM Entity WHERE EntityID = ?", (ref_id,))
    guid = cursor_data.fetchone()[0]
    
    # 1. Print all column names in EntityIdentification
    cursor_data.execute("SELECT COLUMN_NAME FROM INFORMATION_SCHEMA.COLUMNS WHERE TABLE_NAME = 'EntityIdentification'")
    columns = [r[0] for r in cursor_data.fetchall()]
    print("=== Columns in EntityIdentification ===")
    print(columns)
    
    # 2. Print all rows with all columns for this EntityGUID
    print(f"\n=== All Rows in EntityIdentification for {ref_id} ===")
    cursor_data.execute(f"SELECT * FROM EntityIdentification WHERE EntityGUID = ?")
    rows = cursor_data.fetchall()
    for row in rows:
        row_dict = dict(zip(columns, row))
        print(row_dict)

    cursor_data.close()
    conn_data.close()

if __name__ == "__main__":
    main()

