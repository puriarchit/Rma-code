# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    conn_str = f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Data;Trusted_Connection=yes;"
    conn = pyodbc.connect(conn_str, autocommit=True)
    cursor = conn.cursor()

    # Get EntityGUID of 10001598
    cursor.execute("SELECT EntityGUID FROM Entity WHERE EntityID = '10001598'")
    guid = cursor.fetchone()
    if not guid:
        print("Entity 10001598 not found.")
        return
    guid = guid[0]
    print(f"EntityGUID for 10001598: {guid}")

    # Check raw EntityDOB in LexisNexis_Data
    cursor.execute("""
        SELECT EntityDOBGUID, BirthYear, BirthMonth, BirthDay
        FROM EntityDOB
        WHERE EntityGUID = ?
    """, (guid,))
    print("\n--- Production Raw DOBs ---")
    for row in cursor.fetchall():
        print(f"GUID: {row[0]} | Year: {row[1]} | Month: {row[2]} | Day: {row[3]}")

    cursor.close()
    conn.close()

if __name__ == "__main__":
    main()
