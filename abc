# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    trusted = "yes" if db["trusted_connection"] else "no"
    
    # Connect to Data (production/SSIS)
    conn_data = pyodbc.connect(f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Data;Trusted_Connection={trusted};")
    cursor_data = conn_data.cursor()
    
    # Connect to Staging (python)
    conn_staging = pyodbc.connect(f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Staging;Trusted_Connection={trusted};")
    cursor_staging = conn_staging.cursor()

    for ref_id in ['9998846', '9998851']:
        print(f"\n================ Raw Identifications for ReferenceID {ref_id} ================")
        
        # Get EntityGUID
        cursor_data.execute("SELECT EntityGUID FROM Entity WHERE EntityID = ?", (ref_id,))
        row = cursor_data.fetchone()
        if not row:
            print("Entity not found in LexisNexis_Data")
            continue
        guid = row[0]
        
        print("--- LexisNexis_Data.dbo.EntityIdentification ---")
        cursor_data.execute("""
            SELECT EntityIdentificationGUID, IdentificationTypeDesc, IdentificationNumber 
            FROM EntityIdentification 
            WHERE EntityGUID = ?
            ORDER BY EntityIdentificationGUID
        """, (guid,))
        for r in cursor_data.fetchall():
            print(f"GUID: {r[0]} | Type: {r[1]} | Num: {r[2]}")
            
        print("--- LexisNexis_Staging.dbo.EntityIdentification ---")
        cursor_staging.execute("""
            SELECT EntityIdentificationGUID, IdentificationTypeDesc, IdentificationNumber 
            FROM EntityIdentification 
            WHERE EntityGUID = ?
            ORDER BY EntityIdentificationGUID
        """, (guid,))
        for r in cursor_staging.fetchall():
            print(f"GUID: {r[0]} | Type: {r[1]} | Num: {r[2]}")

    cursor_data.close()
    conn_data.close()
    cursor_staging.close()
    conn_staging.close()

if __name__ == "__main__":
    main()
