-- 1. Dono databases ka total row count side-by-side
SELECT 'LexisNexis_Data' AS DbName, COUNT(*) AS TotalCount FROM LexisNexis_Data.dbo.NegativeList_New1
UNION ALL
SELECT 'LexisNexis_Staging' AS DbName, COUNT(*) AS TotalCount FROM LexisNexis_Staging.dbo.NegativeList_New1;

-- 2. Dono databases ka key categories count side-by-side
SELECT 'LexisNexis_Data' AS DbName, 
       CASE WHEN WLType IS NULL THEN 'NULL (None)' ELSE WLType END AS Category, 
       COUNT(*) AS Count 
FROM LexisNexis_Data.dbo.NegativeList_New1 
WHERE WLType IS NULL OR WLType = 'PEP'
GROUP BY WLType
UNION ALL
SELECT 'LexisNexis_Staging' AS DbName, 
       CASE WHEN WLType IS NULL THEN 'NULL (None)' ELSE WLType END AS Category, 
       COUNT(*) AS Count 
FROM LexisNexis_Staging.dbo.NegativeList_New1 
WHERE WLType IS NULL OR WLType = 'PEP'
GROUP BY WLType;
