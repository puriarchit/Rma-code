# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    conn_str = f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE={db['name']};Trusted_Connection=yes;"
    conn = pyodbc.connect(conn_str, autocommit=True)
    cursor = conn.cursor()

    # Get EntityGUID of 7416380
    cursor.execute("SELECT EntityGUID FROM Entity WHERE EntityID = '7416380'")
    guid = cursor.fetchone()
    if not guid:
        print("Entity 7416380 not found.")
        return
    guid = guid[0]
    print(f"EntityGUID for 7416380: {guid}")

    # Query raw EntityIdentification in Staging (loaded from file)
    cursor.execute("""
        SELECT EntityIdentificationGUID, IdentificationTypeDesc, IdentificationNumber, LastUpdated
        FROM EntityIdentification
        WHERE EntityGUID = ?
    """, (guid,))
    print("\n--- Staging (Python) Raw Identifications ---")
    for row in cursor.fetchall():
        print(f"GUID: {row[0]} | Type: {row[1]} | Number: {row[2]} | LastUpdated: {row[3]}")

    # Query raw EntityIdentification in Production
    conn_prod_str = f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Data;Trusted_Connection=yes;"
    conn_prod = pyodbc.connect(conn_prod_str, autocommit=True)
    cursor_prod = conn_prod.cursor()
    cursor_prod.execute("""
        SELECT EntityIdentificationGUID, IdentificationTypeDesc, IdentificationNumber, LastUpdated
        FROM EntityIdentification
        WHERE EntityGUID = ?
    """, (guid,))
    print("\n--- Production (SSIS) Raw Identifications ---")
    for row in cursor_prod.fetchall():
        print(f"GUID: {row[0]} | Type: {row[1]} | Number: {row[2]} | LastUpdated: {row[3]}")

    cursor.close()
    cursor_prod.close()
    conn.close()
    conn_prod.close()

if __name__ == "__main__":
    main()

