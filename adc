# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    
    # We want to connect to LexisNexis_Data
    conn_str = f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE=LexisNexis_Data;Trusted_Connection=yes;"
    conn = pyodbc.connect(conn_str, autocommit=True)
    cursor = conn.cursor()

    # Get EntityGUID of 7416380
    cursor.execute("SELECT EntityGUID FROM Entity WHERE EntityID = '7416380'")
    guid = cursor.fetchone()
    if not guid:
        print("Entity 7416380 not found in LexisNexis_Data.")
        return
    guid = guid[0]
    print(f"Production EntityGUID: {guid}")

    # Check EntityIdentification_Test in LexisNexis_Data (if it exists)
    try:
        cursor.execute("""
            SELECT IdentificationTypeDesc, IdentificationNumber, row_rank
            FROM EntityIdentification_Test
            WHERE EntityGUID = ?
            ORDER BY row_rank
        """, (guid,))
        print("\n--- EntityIdentification_Test rows in LexisNexis_Data ---")
        for row in cursor.fetchall():
            print(f"Type: {row[0]} | Number: {row[1]} | RowRank: {row[2]}")
    except Exception as e:
        print(f"Could not query EntityIdentification_Test in LexisNexis_Data: {e}")

    # Check the actual Query 4 execution output on LexisNexis_Data
    try:
        cursor.execute("""
            select
                P.EntityGUID 
              ,  p.IdentificationTypeDesc,P.IdentificationNumber  
             ,  ROW_NUMBER() over (    partition  by P.EntityGUID 
                                        order by P.EntityGUID  desc
                                   ) as row_rank
            from  (
            select * from EntityIdentification where EntityGUID  not in  (select EntityGUID from EntityIdentification_National_New)
            )  p
            where P.EntityGUID = ?
            group  by
             P.EntityGUID ,  p.IdentificationTypeDesc,P.IdentificationNumber
        """, (guid,))
        print("\n--- Query 4 Output on LexisNexis_Data ---")
        for row in cursor.fetchall():
            print(f"Type: {row[1]} | Number: {row[2]} | RowRank: {row[3]}")
    except Exception as e:
        print(f"Could not run Query 4 on LexisNexis_Data: {e}")

    cursor.close()
    conn.close()

if __name__ == "__main__":
    main()

