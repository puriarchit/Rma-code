# -*- coding: utf-8 -*-
import json
import os
import pyodbc

def load_config() -> dict:
    config_path = r"D:\LexisNexis\config.json"
    with open(config_path, "r", encoding="utf-8") as f:
        return json.load(f)

def main():
    config = load_config()
    db = config["database"]
    conn_str = f"DRIVER={{{db['driver']}}};SERVER={db['server']};DATABASE={db['name']};Trusted_Connection=yes;"
    conn = pyodbc.connect(conn_str, autocommit=True)
    cursor = conn.cursor()

    ids = ['1000157', '1000158']
    for eid in ids:
        cursor.execute("SELECT EntityGUID, EntityTypeDesc, Gender, Name, FirstName, MiddleName, LastName, Title FROM Entity WHERE EntityID = ?", (eid,))
        row = cursor.fetchone()
        if row:
            print(f"\nEntityID: {eid}")
            print(f"  EntityGUID: {row[0]}")
            print(f"  EntityTypeDesc: {row[1]}")
            print(f"  Gender: {row[2]}")
            print(f"  Name (SecondName source): {repr(row[3])}")
            print(f"  FirstName: {repr(row[4])}")
            print(f"  MiddleName: {repr(row[5])}")
            print(f"  LastName: {repr(row[6])}")
            print(f"  Title: {repr(row[7])}")
        else:
            print(f"EntityID {eid} not found in raw Entity table.")

    cursor.close()
    conn.close()

if __name__ == "__main__":
    main()
