-- -------------------------------------------------------------------------------
-- QUERY 3: DYNAMIC ID SLOT SORTING COMPARISON (AUTOMATIC MATCHING)
-- -------------------------------------------------------------------------------
SELECT 
    'SSIS Production (MoneyWaveRemit - Random)' COLLATE DATABASE_DEFAULT AS Engine_And_Database, 
    ReferenceID, 
    IdOtherInfo1, 
    IdNo1, 
    IdOtherInfo2, 
    IdNo2
FROM MoneyWaveRemit.dbo.NegativeList
WHERE IdOtherInfo1 IS NOT NULL AND IdOtherInfo2 IS NOT NULL
  AND ReferenceID IN (
      SELECT TOP 1 ReferenceID 
      FROM MoneyWaveRemit.dbo.NegativeList 
      WHERE IdOtherInfo1 IS NOT NULL AND IdOtherInfo2 IS NOT NULL
  )

UNION ALL

SELECT 
    'Python Production (LexisNexis_Staging - Alphabetical)' COLLATE DATABASE_DEFAULT AS Engine_And_Database, 
    ReferenceID, 
    IdOtherInfo1, 
    IdNo1, 
    IdOtherInfo2, 
    IdNo2
FROM LexisNexis_Staging.dbo.NegativeList
WHERE IdOtherInfo1 IS NOT NULL AND IdOtherInfo2 IS NOT NULL
  AND ReferenceID IN (
      SELECT TOP 1 ReferenceID 
      FROM MoneyWaveRemit.dbo.NegativeList 
      WHERE IdOtherInfo1 IS NOT NULL AND IdOtherInfo2 IS NOT NULL
  );
