-- Query 3A: SSIS Legacy Output (LexisNexis_Data)
SELECT TOP 2 
    'SSIS Staging (LexisNexis_Data - Random)' AS Engine_And_Database, 
    EntityGUID, 
    IdentificationTypeDesc, 
    IdentificationNumber
FROM LexisNexis_Data.dbo.EntityIdentification;

-- Query 3B: Python Migrated Output (LexisNexis_Staging)
SELECT TOP 2 
    'Python Staging (LexisNexis_Staging - Alphabetical)' AS Engine_And_Database, 
    EntityGUID, 
    IdentificationTypeDesc, 
    IdentificationNumber
FROM LexisNexis_Staging.dbo.EntityIdentification;
