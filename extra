-- Query 2: Production Row Count Parity Query
SELECT 'dbo.NegativeList (Production Table)' AS TableName, COUNT(*) AS TotalRows 
FROM LexisNexis_Staging.dbo.NegativeList
UNION ALL
SELECT 'dbo.NegativeListFilter (Search Table)' AS TableName, COUNT(*) AS TotalRows 
FROM LexisNexis_Staging.dbo.NegativeListFilter
UNION ALL
SELECT 'dbo.NegativeList_Master (Master View)' AS TableName, COUNT(*) AS TotalRows 
FROM LexisNexis_Staging.dbo.NegativeList_Master;



