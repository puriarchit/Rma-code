-- Single Screenshot Query: Base Profiles Staging Match
SELECT 
    'SSIS Staging (LexisNexis_Data.dbo.NegativeList_New1)' AS Environment, 
    COUNT(*) AS BaseProfilesCount 
FROM LexisNexis_Data.dbo.NegativeList_New1

UNION ALL

SELECT 
    'Python Staging (LexisNexis_Staging.dbo.NegativeList_New1)' AS Environment, 
    COUNT(*) AS BaseProfilesCount 
FROM LexisNexis_Staging.dbo.NegativeList_New1;




-- Single Screenshot Query: Production Main & Search Filter Tables Match
SELECT 
    'dbo.NegativeList (Production Target Table)' AS TableName, 
    COUNT(*) AS TotalRows 
FROM MoneyWaveRemit.dbo.NegativeList

UNION ALL

SELECT 
    'dbo.NegativeListFilter (Search Filter Table)' AS TableName, 
    COUNT(*) AS TotalRows 
FROM MoneyWaveRemit.dbo.NegativeListFilter;



-- Single Screenshot Query: ID Slot Alphabetical Ranking Comparison
SELECT 
    'SSIS Output (LexisNexis_Data - Random)' AS PipelineEngine, 
    EntityGUID, IdentificationTypeDesc, IdentificationNumber
FROM LexisNexis_Data.dbo.EntityIdentification
WHERE EntityGUID = '00002167-93C0-466D-B0DC-F07A3B7E9871'

UNION ALL

SELECT 
    'Python Output (LexisNexis_Staging - Alphabetical)' AS PipelineEngine, 
    EntityGUID, IdentificationTypeDesc, IdentificationNumber
FROM LexisNexis_Staging.dbo.EntityIdentification
WHERE EntityGUID = '00002167-93C0-466D-B0DC-F07A3B7E9871';
