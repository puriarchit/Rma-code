    # -----------------------------------------------------------------
    cursor.execute("INSERT INTO #AffectedIDs (ID) SELECT ID FROM #ChangeSet UNION SELECT ID FROM #NewIDs")
    cursor.connection.commit()

    logging.info("Phase C completed (updates: base=%d, alias=%d; inserts: base=%d, alias=%d) in %.2f seconds",
                 updated_base, updated_alias, inserted_base, inserted_alias, time.time() - phase_c_start)
    return {
        "run_version_id": run_version_id,
        "updated_base": updated_base,
        "updated_alias": updated_alias,
        "inserted_base": inserted_base,
        "inserted_alias": inserted_alias,
        "total_affected": cursor.execute("SELECT COUNT(*) FROM #AffectedIDs").fetchone()[0]
