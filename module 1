print("Starting Optimized Direct ZIP database loader (Dynamic Batch Mode)...\n")
global_start = time.time()

with zipfile.ZipFile(zip_path, "r") as z:
    zip_files = z.namelist()
    
    for filename, tablename in files_list:
        target_path = None
        for zf in zip_files:
            if zf.lower().endswith(filename.lower()):
                target_path = zf
                break
                
        if target_path:
            print("Loading:", filename)
            file_start = time.time()
            
            cursor.execute(f"TRUNCATE TABLE {tablename}")
            
            cursor.execute(f"SELECT TOP 0 * FROM {tablename}")
            col_count = len(cursor.description)
            
            # Dynamic batch size: EntityRemark ke liye 1000, baaki sab ke liye 50000
            current_batch_size = 1000 if tablename == "EntityRemark" else 50000
            
            f = z.open(target_path, "r")
            f.readline()
            
            rows = []
            total_loaded = 0
            
            for line_bytes in f:
                line = line_bytes.decode("utf-8", errors="ignore")
                fields = line.strip('\r\n').split('|')
                
                if not fields or fields == ['']:
                    continue
                
                clean_fields = [val.strip() if (val and val.strip() != "") else None for val in fields[:col_count]]
                if len(clean_fields) < col_count:
                    clean_fields += [None] * (col_count - len(clean_fields))
                
                rows.append(clean_fields)
                
                if len(rows) >= current_batch_size:
                    placeholders = ", ".join(["?" for _ in range(col_count)])
                    insert_query = f"INSERT INTO {tablename} VALUES ({placeholders})"
                    cursor.executemany(insert_query, rows)
                    conn.commit()
                    total_loaded += len(rows)
                    rows.clear()
            
            if rows:
                placeholders = ", ".join(["?" for _ in range(col_count)])
                insert_query = f"INSERT INTO {tablename} VALUES ({placeholders})"
                cursor.executemany(insert_query, rows)
                conn.commit()
                total_loaded += len(rows)
                
            f.close()
            
            file_end = time.time()
            time_taken = file_end - file_start
            print(f"✅ {filename} done! (Total {total_loaded} rows loaded) - Time: {time_taken:.2f} seconds\n")
        else:
            print("Not found inside ZIP:", filename)

cursor.close()
