import os
import pyodbc

server = "WIN-Q6F1HDK5R4D"
database = "LexisNexis_Staging"
folder = r"D:\LexisNexis\Omni_DataMart_Lexisnexis_Test\Omni_DataMart_Lexisnexis_Test\DataSource"

print("Connecting to database...")
conn_str = f"DRIVER={{ODBC Driver 17 for SQL Server}};SERVER={server};DATABASE={database};Trusted_Connection=yes;"
conn = pyodbc.connect(conn_str)
cursor = conn.cursor()
cursor.fast_executemany = True

print("Connection established successfully!")

files_list = [
    ("AssociatedEntity.txt", "AssociatedEntity"),
    ("ConsolidatedSanction.txt", "ConsolidatedSanction"),
    ("EntityAdverseMedia.txt", "EntityAdverseMedia"),
    ("EntityAdverseMediaSubCategory.txt", "EntityAdverseMediaSubCategory"),
    ("EntityDeletes.txt", "EntityDeletes"),
    ("EntityDOB.txt", "EntityDOB"),
    ("EntitySanction.txt", "EntitySanction")
]

for filename, tablename in files_list:
    filepath = os.path.join(folder, filename)
    
    if os.path.exists(filepath):
        print(f"\n--- Processing: {filename} ---")
        
        print("Step 1: Truncating table...")
        cursor.execute(f"TRUNCATE TABLE {tablename}")
        
        print("Step 2: Fetching column count...")
        cursor.execute(f"SELECT TOP 0 * FROM {tablename}")
        col_count = len(cursor.description)
        print(f"Table {tablename} has {col_count} columns.")
        
        print("Step 3: Reading file lines into memory...")
        f = open(filepath, "r", encoding="utf-8", errors="ignore")
        f.readline()
        
        rows = []
        for line in f:
            fields = line.strip('\n').split('\t')
            if not fields or fields == ['']:
                continue
            
            clean_fields = []
            for val in fields:
                if val:
                    clean_fields.append(val.strip().replace("'", "''"))
                else:
                    clean_fields.append(None)
            
            if len(clean_fields) < col_count:
                clean_fields.extend([None] * (col_count - len(clean_fields)))
            else:
                clean_fields = clean_fields[:col_count]
                
            rows.append(clean_fields)
        f.close()
        
        print(f"Step 4: Read complete. Collected {len(rows)} rows. Now executing bulk insert...")
        
        if rows:
            placeholders = ", ".join(["?" for i in range(col_count)])
            insert_query = f"INSERT INTO {tablename} VALUES ({placeholders})"
            cursor.executemany(insert_query, rows)
            
        print("Step 5: Committing transaction...")
        conn.commit()
        print(f"SUCCESS: {filename} fully loaded!\n")
    else:
        print(f"File not found: {filename}")

cursor.close()
conn.close()
print("All files loaded successfully!")
