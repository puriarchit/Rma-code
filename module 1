import zipfile
import os
import pyodbc

server = "WIN-Q6F1HDK5R4D"
database = "LexisNexis_Staging"
zip_path = r"D:\LexisNexis\MWV01TF_WorldCompliancePlus_20260508_075958.zip"

conn_str = f"DRIVER={{ODBC Driver 17 for SQL Server}};SERVER={server};DATABASE={database};Trusted_Connection=yes;"
conn = pyodbc.connect(conn_str)
cursor = conn.cursor()
cursor.fast_executemany = True

files_list = [
    ("AssociatedEntity.txt", "AssociatedEntity"),
    ("ConsolidatedSanction.txt", "ConsolidatedSanction"),
    ("Entity.txt", "Entity"),
    ("EntityAddress.txt", "EntityAddress"),
    ("EntityAdverseMedia.txt", "EntityAdverseMedia"),
    ("EntityAdverseMediaSubCategory.txt", "EntityAdverseMediaSubCategory"),
    ("EntityAlias.txt", "EntityAlias"),
    ("EntityCountryAssociation.txt", "EntityCountryAssociation"),
    ("EntityDeletes.txt", "EntityDeletes"),
    ("EntityDOB.txt", "EntityDOB"),
    ("EntityEnforcement.txt", "EntityEnforcement"),
    ("EntityEnforcementSubCategory.txt", "EntityEnforcementSubCategory"),
    ("EntityIdentification.txt", "EntityIdentification"),
    ("EntityRemark.txt", "EntityRemark"),
    ("EntitySanction.txt", "EntitySanction"),
    ("EntitySourceItem.txt", "EntitySourceItem")
]

print("Starting direct ZIP database loader (Batch Mode)...\n")

with zipfile.ZipFile(zip_path, "r") as z:
    zip_files = z.namelist()
    
    for filename, tablename in files_list:
        target_path = None
        for zf in zip_files:
            if zf.lower().endswith(filename.lower()):
                target_path = zf
                break
                
        if target_path:
            print("Loading:", filename)
            
            cursor.execute(f"TRUNCATE TABLE {tablename}")
            
            cursor.execute(f"SELECT TOP 0 * FROM {tablename}")
            col_count = len(cursor.description)
            
            f = z.open(target_path, "r")
            f.readline()
            
            rows = []
            total_loaded = 0
            
            for line_bytes in f:
                line = line_bytes.decode("utf-8", errors="ignore")
                fields = line.strip('\r\n').split('|')
                
                if not fields or fields == ['']:
                    continue
                
                clean_fields = []
                for val in fields:
                    if val:
                        clean_fields.append(val.strip().replace("'", "''"))
                    else:
                        clean_fields.append(None)
            
                if len(clean_fields) < col_count:
                    clean_fields.extend([None] * (col_count - len(clean_fields)))
                else:
                    clean_fields = clean_fields[:col_count]
                
                rows.append(clean_fields)
                
                # 50,000 rows hone par bulk load chalana aur memory clear karna
                if len(rows) >= 50000:
                    placeholders = ", ".join(["?" for i in range(col_count)])
                    insert_query = f"INSERT INTO {tablename} VALUES ({placeholders})"
                    cursor.executemany(insert_query, rows)
                    conn.commit()
                    total_loaded += len(rows)
                    rows.clear() # RAM khali karna
            
            # Bache hue rows ko last me insert karna
            if rows:
                placeholders = ", ".join(["?" for i in range(col_count)])
                insert_query = f"INSERT INTO {tablename} VALUES ({placeholders})"
                cursor.executemany(insert_query, rows)
                conn.commit()
                total_loaded += len(rows)
                
            f.close()
            print(filename, f"done! (Total {total_loaded} rows loaded)\n")
        else:
            print("Not found inside ZIP:", filename)

cursor.close()
conn.close()
print("All files loaded successfully!")









import os
import pyodbc
import time

server = "WIN-Q6F1HDK5R4D"
database = "LexisNexis_Staging"
# Unzipped folder ka path jahan files extract hui hain
folder = r"D:\LexisNexis\MWV01TF_WorldCompliancePlus_20260508_075958\MWV01TF_WorldCompliancePlus_20260508_075958"

conn_str = f"DRIVER={{ODBC Driver 17 for SQL Server}};SERVER={server};DATABASE={database};Trusted_Connection=yes;"
conn = pyodbc.connect(conn_str)
cursor = conn.cursor()

files_list = [
    ("AssociatedEntity.txt", "AssociatedEntity"),
    ("ConsolidatedSanction.txt", "ConsolidatedSanction"),
    ("Entity.txt", "Entity"),
    ("EntityAddress.txt", "EntityAddress"),
    ("EntityAdverseMedia.txt", "EntityAdverseMedia"),
    ("EntityAdverseMediaSubCategory.txt", "EntityAdverseMediaSubCategory"),
    ("EntityAlias.txt", "EntityAlias"),
    ("EntityCountryAssociation.txt", "EntityCountryAssociation"),
    ("EntityDeletes.txt", "EntityDeletes"),
    ("EntityDOB.txt", "EntityDOB"),
    ("EntityEnforcement.txt", "EntityEnforcement"),
    ("EntityEnforcementSubCategory.txt", "EntityEnforcementSubCategory"),
    ("EntityIdentification.txt", "EntityIdentification"),
    ("EntityRemark.txt", "EntityRemark"),
    ("EntitySanction.txt", "EntitySanction"),
    ("EntitySourceItem.txt", "EntitySourceItem")
]

print("Starting native SQL Server BULK INSERT Loader...\n")
global_start = time.time()

for filename, tablename in files_list:
    filepath = os.path.join(folder, filename)
    
    if os.path.exists(filepath):
        print(f"Bulk Ingesting: {filename} ...")
        file_start = time.time()
        
        try:
            # 1. Clear old data
            cursor.execute(f"TRUNCATE TABLE {tablename}")
            
            # 2. Run SQL Server native BULK INSERT
            # 65001 handles UTF-8 formatting, TABLOCK optimizes table locks for speed
            bulk_query = f"""
                BULK INSERT {tablename}
                FROM '{filepath}'
                WITH (
                    FIELDTERMINATOR = '|',
                    ROWTERMINATOR = '0x0a',
                    FIRSTROW = 2,
                    CODEPAGE = '65001',
                    TABLOCK
                );
            """
            cursor.execute(bulk_query)
            conn.commit()
            
            # 3. Get exact loaded row count
            cursor.execute(f"SELECT COUNT(*) FROM {tablename}")
            row_count = cursor.fetchone()[0]
            
            file_end = time.time()
            time_taken = file_end - file_start
            print(f"✅ {tablename} loaded! ({row_count} rows) - Time taken: {time_taken:.2f} seconds\n")
            
        except Exception as ex:
            print(f"❌ Error loading {filename}: {ex}\n")
            conn.rollback()
    else:
        print(f"⚠️ File not found, skipping: {filename}\n")

cursor.close()
conn.close()

global_end = time.time()
total_time = (global_end - global_start) / 60
print(f"All files loaded successfully! Total time taken: {total_time:.2f} minutes")
