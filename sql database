    ConsolidatedSanctionGUID NVARCHAR(50),
    EntityGUID NVARCHAR(50),
    LastUpdated DATETIME
);

-- Entity
CREATE TABLE Entity (
    EntityGUID NVARCHAR(50),
    EntityTypeDesc NVARCHAR(50),
    Gender NVARCHAR(50),
    Name NVARCHAR(500),
    FirstName NVARCHAR(200),
    MiddleName NVARCHAR(200),
