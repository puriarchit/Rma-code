-- AssociatedEntity
CREATE TABLE AssociatedEntity (
    EntityGUID NVARCHAR(50),
    AssociatedEntityGUID NVARCHAR(50),
    SubCategoryLabel NVARCHAR(100),
    LastUpdated DATETIME,
    SourceName NVARCHAR(500)
);

-- ConsolidatedSanction
