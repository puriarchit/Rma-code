UNION ALL
SELECT 'EntityAlias', COUNT(*) FROM EntityAlias
UNION ALL
SELECT 'EntityCountryAssociation', COUNT(*) FROM EntityCountryAssociation
UNION ALL
SELECT 'EntityDeletes', COUNT(*) FROM EntityDeletes
UNION ALL
SELECT 'EntityDOB', COUNT(*) FROM EntityDOB
UNION ALL
SELECT 'EntityEnforcement', COUNT(*) FROM EntityEnforcement
UNION ALL
SELECT 'EntityEnforcementSubCategory', COUNT(*) FROM EntityEnforcementSubCategory
UNION ALL
SELECT 'EntityIdentification', COUNT(*) FROM EntityIdentification
UNION ALL
SELECT 'EntityRemark', COUNT(*) FROM EntityRemark
UNION ALL
SELECT 'EntitySanction', COUNT(*) FROM EntitySanction
UNION ALL
